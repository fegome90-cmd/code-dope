{
  "globs": ["**/*.md"],
  "config": {
    "default": true,
    "MD001": false,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD007": { "indent": 2 },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD025": false,
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD045": false,
    "MD058": false
  },
  "ignores": [
    "node_modules/**",
    ".venv/**",
    "dist/**",
    "archive/**",
    "**/archive/**",
    "tools/agent-docs-kit/**"
  ]
}
