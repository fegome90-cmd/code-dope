{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/.worktrees",
      "!**/worktrees",
      "!**/dist",
      "!**/coverage",
      "!**/node_modules",
      "!**/.venv",
      "!**/.vscode",
      "!**/.pnpm-store",
      "!**/.ruff_cache",
      "!**/.mypy_cache",
      "!**/.pytest_cache",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useMathMinMax": "off",
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUnusedImports": "off",
        "noVoidTypeReturn": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "useIterableCallbackReturn": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    }
  }
}
