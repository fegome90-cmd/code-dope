{
  "name": "code-dope",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Code Mode library for agents, plugins and MCP servers: isolated Node executor, policy layer, sandbox helpers and recipes on top of @cloudflare/codemode.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    }
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/run.ts",
    "example:plugin": "node examples/plugin-consumer/run.ts",
    "example:mcp": "node examples/mcp-client/run.ts",
    "test:py": "python3 -B -m unittest tests/test_ptc_helpers.py",
    "test:all": "npm run check:dist && npm test && npm run test:py && npm run typecheck && npm run test:pkg",
    "build": "node scripts/build.mjs",
    "check:dist": "npm run build && git diff --exit-code -- dist/",
    "test:pkg": "node --test tests/package.test.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/codemode": "0.5.6",
    "acorn": "^8.17.0",
    "quickjs-emscripten": "0.32.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "files": [
    "dist",
    "snippets",
    "catalog",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ]
}
