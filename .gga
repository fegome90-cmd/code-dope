# Gentleman Guardian Angel Configuration
# https://github.com/Gentleman-Programming/gga

PROVIDER="claude"

# Archivos de código y configuración revisados en este repo.
FILE_PATTERNS="*.ts,*.tsx,*.js,*.mjs,*.json,*.jsonc,*.md,*.yml,*.yaml,*.toml,*.txt,*.sh,.*rc,pre-commit"
EXCLUDE_PATTERNS="package-lock.json,*.lock"

RULES_FILE="AGENTS.md"
STRICT_MODE="true"
TIMEOUT="600"
PR_BASE_BRANCH="developer"
